{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tethr Tauri Lab",
  "version": "0.1.0",
  "identifier": "com.tethr.lab.tauri",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "tethr · Tauri", "width": 640, "height": 560, "minWidth": 420, "minHeight": 360, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"], "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" } }
}
